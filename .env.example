# Environment Configuration Example
# Copy this file to .env and configure your variables

FLASK_APP=app:create_app
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000
# On macOS, AirPlay Receiver uses port 5000 by default. HOST_PORT allows mapping host 5001 -> container 5000
HOST_PORT=5001

# Database Configuration
DB_HOST=db
DB_PORT=3306
DB_NAME=expense_tracker
DB_USER=expense_user
DB_PASSWORD=expense_password
DB_ROOT_PASSWORD=root_secure_password
